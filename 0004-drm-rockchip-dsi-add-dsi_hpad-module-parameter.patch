From 5f8cc58ec5e282779825c074d049926d1236a954 Mon Sep 17 00:00:00 2001
From: prokrypt <prokrypt@edited.us>
Date: Sun, 11 Oct 2026 19:15:05 -0700
Subject: [PATCH 4/7] drm/rockchip: dsi: add dsi_hpad module parameter

The ClockworkPi CWD686 panel (Chipone ICNL9707) discards the last 5 pixels
of every DSI video line. The panel is rotated, so those are the top 5 rows
of the landscape picture.

With rockchipdrm.dsi_hpad=N, each line sent to the panel is widened by N
pixels at the end, taken from the front porch, so the line start, line
length and refresh rate stay the same. The VOP still sizes the planes from
the requested mode, so the N extra pixels are background (black) and
userspace keeps seeing the panel's real width.

Use on the DevTerm: options rockchipdrm dsi_hpad=5
Details: https://github.com/prokrypt/cwd686-fix
---
 .../gpu/drm/rockchip/dw-mipi-dsi-rockchip.c   | 34 +++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c b/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c
index 3547d91b2..99ab7e48e 100644
--- a/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c
+++ b/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c
@@ -767,6 +767,19 @@ static void dw_mipi_dsi_rockchip_set_lcdsel(struct dw_mipi_dsi_rockchip *dsi,
 			mux ? dsi->cdata->lcdsel_lit : dsi->cdata->lcdsel_big);
 }
 
+/*
+ * Some panels discard the last pixels of every line they receive. The
+ * ClockworkPi cwd686 (Chipone ICNL9707) on the DevTerm drops 5, which cuts
+ * off the top 5 rows of the rotated landscape picture. With dsi_hpad=N the
+ * line actually sent is widened by N pixels at the end, taken from the
+ * front porch, so the line start and the refresh rate stay the same. The VOP
+ * still sizes the planes from the requested mode, so those N pixels are
+ * background (black) and userspace keeps seeing the panel's real width.
+ */
+static int dsi_hpad;
+module_param(dsi_hpad, int, 0444);
+MODULE_PARM_DESC(dsi_hpad, "Black pixels to send after each DSI video line (default 0)");
+
 static int
 dw_mipi_dsi_encoder_atomic_check(struct drm_encoder *encoder,
 				 struct drm_crtc_state *crtc_state,
@@ -791,6 +804,27 @@ dw_mipi_dsi_encoder_atomic_check(struct drm_encoder *encoder,
 	}
 
 	s->output_type = DRM_MODE_CONNECTOR_DSI;
+
+	if (dsi_hpad > 0) {
+		const struct drm_display_mode *mode = &crtc_state->mode;
+		struct drm_display_mode *adj = &crtc_state->adjusted_mode;
+
+		/*
+		 * Derive from the requested mode, not from adjusted_mode: this
+		 * check can run more than once on the same state.
+		 */
+		if (mode->hsync_start - mode->hdisplay > dsi_hpad) {
+			adj->hdisplay = mode->hdisplay + dsi_hpad;
+			adj->hsync_start = mode->hsync_start;
+			adj->hsync_end = mode->hsync_end;
+			adj->htotal = mode->htotal;
+			DRM_DEV_DEBUG_KMS(dsi->dev, "dsi_hpad=%d: %d %d %d %d\n", dsi_hpad,
+					  adj->hdisplay, adj->hsync_start, adj->hsync_end, adj->htotal);
+		} else {
+			DRM_DEV_ERROR(dsi->dev, "front porch too short for dsi_hpad=%d\n", dsi_hpad);
+		}
+	}
+
 	if (dsi->slave)
 		s->output_flags = ROCKCHIP_OUTPUT_DSI_DUAL;
 
