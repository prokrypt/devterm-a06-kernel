From 35c3aad006cfca1d47b5a0d79ceaab22c56bffee Mon Sep 17 00:00:00 2001
From: prokrypt <prokrypt@edited.us>
Date: Sun, 11 Oct 2026 19:15:05 -0700
Subject: [PATCH 5/7] power: axp20x, mfd: rk8xx: ClockworkPi A06 power support

AXP228 battery and charger additions, and RK808 power-off preparation, for
the ClockworkPi A06.

Source: yatli/arch-linux-arm-clockworkpi
(0002-mfd-axp20x-add-clockworkpi-a06-power-support.patch). The
drivers were restructured since 6.2, so this was ported by hand:

- axp20x_battery: ENERGY_FULL/_FULL_DESIGN/_NOW, POWER_NOW (computed from
  fresh voltage and current reads) and a writable CALIBRATE property. The
  design capacity from DT (charge-full-design-microamp-hours) is written to
  the fuel gauge.
- axp20x_battery probe and axp20x_ac_power IRQ: the A06 register setup
  (VBUS current limit, charger and PEK settings).
- rk8xx: switch RK808 LDO4 off before power-off (the AXP228 powers the
  board off).

All board-specific register writes are gated on
of_machine_is_compatible("clockwork,devterm-a06"). The original
"pm_power_off = 0" hack in axp20x.c is no longer needed: the AXP power-off
handler is registered unconditionally since 6.x.
---
 drivers/mfd/rk8xx-core.c               | 23 ++++++
 drivers/power/supply/axp20x_ac_power.c |  6 ++
 drivers/power/supply/axp20x_battery.c  | 99 +++++++++++++++++++++++++-
 3 files changed, 127 insertions(+), 1 deletion(-)

diff --git a/drivers/mfd/rk8xx-core.c b/drivers/mfd/rk8xx-core.c
index 3dcf6abfd..2cef117e9 100644
--- a/drivers/mfd/rk8xx-core.c
+++ b/drivers/mfd/rk8xx-core.c
@@ -15,6 +15,7 @@
 #include <linux/mfd/rk808.h>
 #include <linux/mfd/core.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/property.h>
 #include <linux/regmap.h>
 #include <linux/reboot.h>
@@ -667,6 +668,19 @@ static const struct regmap_irq_chip rk818_irq_chip = {
 	.init_ack_masked = true,
 };
 
+/*
+ * ClockworkPi A06: the AXP228 powers the board off, but LDO4 on the RK808
+ * has to be switched off first (from yatli's 0002 patch).
+ */
+static int rk808_a06_power_off_prepare(struct sys_off_data *data)
+{
+	struct rk808 *rk808 = data->cb_data;
+
+	regmap_update_bits(rk808->regmap, RK808_LDO_EN_REG, 0x08, 0x00);
+
+	return NOTIFY_DONE;
+}
+
 static int rk808_power_off(struct sys_off_data *data)
 {
 	struct rk808 *rk808 = data->cb_data;
@@ -872,6 +886,15 @@ int rk8xx_probe(struct device *dev, int variant, unsigned int irq, struct regmap
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to add MFD devices\n");
 
+	if (rk808->variant == RK808_ID &&
+	    of_machine_is_compatible("clockwork,devterm-a06")) {
+		ret = devm_register_sys_off_handler(dev,
+				    SYS_OFF_MODE_POWER_OFF_PREPARE, SYS_OFF_PRIO_DEFAULT,
+				    &rk808_a06_power_off_prepare, rk808);
+		if (ret)
+			dev_warn(dev, "failed to register A06 sys-off handler: %d\n", ret);
+	}
+
 	if (device_property_read_bool(dev, "system-power-controller") ||
 	    device_property_read_bool(dev, "rockchip,system-power-controller")) {
 		ret = devm_register_sys_off_handler(dev,
diff --git a/drivers/power/supply/axp20x_ac_power.c b/drivers/power/supply/axp20x_ac_power.c
index 5f6ea416f..b4d27b39a 100644
--- a/drivers/power/supply/axp20x_ac_power.c
+++ b/drivers/power/supply/axp20x_ac_power.c
@@ -52,6 +52,12 @@ static irqreturn_t axp20x_ac_power_irq(int irq, void *devid)
 {
 	struct axp20x_ac_power *power = devid;
 
+	/* ClockworkPi A06: toggle the VBUS current limit setting on plug events (yatli 0002) */
+	if (of_machine_is_compatible("clockwork,devterm-a06")) {
+		regmap_update_bits(power->regmap, AXP20X_VBUS_IPSOUT_MGMT, 0x03, 0x00);
+		regmap_update_bits(power->regmap, AXP20X_VBUS_IPSOUT_MGMT, 0x03, 0x03);
+	}
+
 	power_supply_changed(power->supply);
 
 	return IRQ_HANDLED;
diff --git a/drivers/power/supply/axp20x_battery.c b/drivers/power/supply/axp20x_battery.c
index 50ca8e110..2f1764fe1 100644
--- a/drivers/power/supply/axp20x_battery.c
+++ b/drivers/power/supply/axp20x_battery.c
@@ -21,6 +21,7 @@
 #include <linux/err.h>
 #include <linux/interrupt.h>
 #include <linux/irq.h>
+#include <linux/math64.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
@@ -79,6 +80,11 @@
 #define AXP717_ITERM_CC_STEP		64000
 
 #define AXP20X_V_OFF_MASK		GENMASK(2, 0)
+
+/* ClockworkPi A06 (AXP228) fuel gauge calibration bits in AXP20X_CC_CTRL */
+#define AXP228_FULL_CAPACITY_CALIBRATE_EN	BIT(5)
+#define AXP228_CAPACITY_CALIBRATE		BIT(4)
+#define AXP228_CALIBRATE_MASK			(BIT(4) | BIT(5))
 #define AXP717_V_OFF_MASK		GENMASK(6, 4)
 
 #define AXP717_BAT_VMIN_MIN_UV		2600000
@@ -120,6 +126,8 @@ struct axp20x_batt_ps {
 	unsigned int max_ccc;
 	const struct axp_data	*data;
 	bool ts_disable;
+	/* from DT energy-full-design-microwatt-hours */
+	int energy_full_design;
 };
 
 static int axp20x_battery_get_max_voltage(struct axp20x_batt_ps *axp20x_batt,
@@ -418,6 +426,61 @@ static int axp20x_battery_get_prop(struct power_supply *psy,
 
 		break;
 
+	case POWER_SUPPLY_PROP_ENERGY_FULL:
+	case POWER_SUPPLY_PROP_ENERGY_FULL_DESIGN:
+	case POWER_SUPPLY_PROP_ENERGY_NOW:
+		/* When no battery is present, return 0 */
+		ret = regmap_read(axp20x_batt->regmap, AXP20X_PWR_OP_MODE,
+				  &reg);
+		if (ret)
+			return ret;
+
+		if (!(reg & AXP20X_PWR_OP_BATT_PRESENT)) {
+			val->intval = 0;
+			return 0;
+		}
+
+		if (psp != POWER_SUPPLY_PROP_ENERGY_NOW) {
+			val->intval = axp20x_batt->energy_full_design;
+			return 0;
+		}
+
+		ret = regmap_read(axp20x_batt->regmap, AXP20X_FG_RES, &reg);
+		if (ret)
+			return ret;
+
+		if (axp20x_batt->data->has_fg_valid && !(reg & AXP22X_FG_VALID))
+			return -EINVAL;
+
+		val1 = clamp(reg & AXP209_FG_PERCENT, 0, 100);
+		val->intval = div_s64((s64)val1 * axp20x_batt->energy_full_design,
+				      100);
+		break;
+
+	case POWER_SUPPLY_PROP_CALIBRATE:
+		/* both the calibrate enable flag and the calibration status */
+		ret = regmap_read(axp20x_batt->regmap, AXP20X_CC_CTRL, &reg);
+		if (ret)
+			return ret;
+
+		val->intval = reg & AXP228_CALIBRATE_MASK;
+		break;
+
+	case POWER_SUPPLY_PROP_POWER_NOW: {
+		union power_supply_propval v, i;
+
+		ret = axp20x_battery_get_prop(psy, POWER_SUPPLY_PROP_VOLTAGE_NOW, &v);
+		if (ret)
+			return ret;
+		ret = axp20x_battery_get_prop(psy, POWER_SUPPLY_PROP_CURRENT_NOW, &i);
+		if (ret)
+			return ret;
+
+		/* uV * uA -> uW */
+		val->intval = div_s64((s64)v.intval * i.intval, 1000000);
+		break;
+	}
+
 	default:
 		return -EINVAL;
 	}
@@ -785,6 +848,11 @@ static int axp20x_battery_set_prop(struct power_supply *psy,
 	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX:
 		return axp20x_set_max_constant_charge_current(axp20x_batt,
 							      val->intval);
+	case POWER_SUPPLY_PROP_CALIBRATE:
+		return regmap_update_bits(axp20x_batt->regmap, AXP20X_CC_CTRL,
+					  AXP228_CALIBRATE_MASK,
+					  val->intval ? (AXP228_FULL_CAPACITY_CALIBRATE_EN |
+							 AXP228_CAPACITY_CALIBRATE) : 0);
 	case POWER_SUPPLY_PROP_STATUS:
 		switch (val->intval) {
 		case POWER_SUPPLY_STATUS_CHARGING:
@@ -850,6 +918,11 @@ static enum power_supply_property axp20x_battery_props[] = {
 	POWER_SUPPLY_PROP_VOLTAGE_MAX,
 	POWER_SUPPLY_PROP_VOLTAGE_MIN,
 	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_ENERGY_FULL,
+	POWER_SUPPLY_PROP_ENERGY_FULL_DESIGN,
+	POWER_SUPPLY_PROP_ENERGY_NOW,
+	POWER_SUPPLY_PROP_CALIBRATE,
+	POWER_SUPPLY_PROP_POWER_NOW,
 };
 
 static enum power_supply_property axp717_battery_props[] = {
@@ -873,7 +946,8 @@ static int axp20x_battery_prop_writeable(struct power_supply *psy,
 	       psp == POWER_SUPPLY_PROP_VOLTAGE_MIN ||
 	       psp == POWER_SUPPLY_PROP_VOLTAGE_MAX ||
 	       psp == POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT ||
-	       psp == POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX;
+	       psp == POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX ||
+	       psp == POWER_SUPPLY_PROP_CALIBRATE;
 }
 
 static int axp717_battery_prop_writeable(struct power_supply *psy,
@@ -976,6 +1050,18 @@ static void axp209_set_battery_info(struct platform_device *pdev,
 		axp_batt->max_ccc = ccc;
 		axp20x_set_constant_charge_current(axp_batt, ccc);
 	}
+
+	if (info->energy_full_design_uwh > 0)
+		axp_batt->energy_full_design = info->energy_full_design_uwh;
+
+	/* tell the fuel gauge about the battery: 15 bits, 1.456 mAh per LSB */
+	if (info->charge_full_design_uah > 0) {
+		int cap = info->charge_full_design_uah / 1456;
+
+		regmap_write(axp_batt->regmap, AXP288_FG_DES_CAP0_REG, cap & 0xff);
+		regmap_write(axp_batt->regmap, AXP288_FG_DES_CAP1_REG,
+			     BIT(7) | ((cap >> 8) & 0x7f));
+	}
 }
 
 static void axp717_set_battery_info(struct platform_device *pdev,
@@ -1110,6 +1196,9 @@ static int axp20x_power_probe(struct platform_device *pdev)
 	axp20x_batt->regmap = dev_get_regmap(pdev->dev.parent, NULL);
 	platform_set_drvdata(pdev, axp20x_batt);
 
+	/* used when DT gives no energy-full-design-microwatt-hours */
+	axp20x_batt->energy_full_design = 8000000;
+
 	psy_cfg.drv_data = axp20x_batt;
 	psy_cfg.fwnode = dev_fwnode(&pdev->dev);
 
@@ -1139,6 +1228,14 @@ static int axp20x_power_probe(struct platform_device *pdev)
 	 */
 	axp20x_get_constant_charge_current(axp20x_batt, &axp20x_batt->max_ccc);
 
+	if (of_machine_is_compatible("clockwork,devterm-a06")) {
+		/* board setup from yatli's 0002 patch (no VBUS current limit, charger and PEK settings) */
+		regmap_update_bits(axp20x_batt->regmap, AXP20X_VBUS_IPSOUT_MGMT, 0x03, 0x03);
+		regmap_update_bits(axp20x_batt->regmap, AXP20X_OFF_CTRL, 0x08, 0x08);
+		regmap_update_bits(axp20x_batt->regmap, AXP20X_CHRG_CTRL2, 0x30, 0x20);
+		regmap_update_bits(axp20x_batt->regmap, AXP20X_PEK_KEY, 0x0f, 0x0b);
+	}
+
 	return 0;
 }
 
